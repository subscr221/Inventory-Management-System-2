+  coverage_id: string;
+  asset_id: string;
+  coverage_type: 'amc' | 'warranty' | 'insurance';
+  provider_name: string;
+  reference_number_ext: string;
+  start_date: string;
+  expiry_date: string;
+  /** Exact decimal string (NUMERIC(14,3)) or null; never a JS number. */
+  contract_value: string | null;
