DB_HOST=localhost
DB_PORT=5432
DB_NAME=inventory_events
DB_USER=app_user
DB_PASSWORD=app_password
# DDL-only credentials for migrations - never used by the running app for request-serving queries.
DB_ADMIN_USER=admin_user
DB_ADMIN_PASSWORD=admin_password
DB_SSL=false
# Used only by deploy/compose/docker-compose.yml's postgres-standby service (pg_basebackup).
REPLICATION_PASSWORD=replication_password
PORT=3000
HOSTNAME=0.0.0.0
NODE_ENV=development
POSTGRES_ADMIN_PASSWORD=admin_password

# Auth: AUTH_MODE=oidc (default, production) requires AUTH_JWKS_URI/AUTH_ISSUER/AUTH_AUDIENCE.
# AUTH_MODE=local (dev/test only) requires AUTH_LOCAL_SECRET and exposes an unauthenticated
# dev-token endpoint. It is refused at startup unless NODE_ENV is explicitly "development" or
# "test". This is a DEVELOPMENT template - never deploy it verbatim to a real environment; for
# staging/production set AUTH_MODE=oidc and NODE_ENV=production.
AUTH_MODE=local
AUTH_LOCAL_SECRET=replace-with-a-long-random-dev-only-secret
AUTH_JWKS_URI=
AUTH_ISSUER=
AUTH_AUDIENCE=
# Which verified-token claim names the directory record (users.external_id). Default sub. The
# staging Keycloak (deploy/keycloak/realm-ims.json) uses email as the username, so staging sets
# AUTH_SUBJECT_CLAIM=email and the roles file's email is the identity. Never recycle a mailbox.
AUTH_SUBJECT_CLAIM=sub

# SCIM: required in all modes, no default value permitted.
SCIM_BEARER_TOKEN=replace-with-a-long-random-scim-bearer-token

# Audit: non-disableable statutory edit log (FR-AC-13).
# AUDIT_LOG_ENABLED must be "true" - the application refuses to start if set to "false".
# AUDIT_LOG_RETENTION_YEARS controls how long entries stay online before archival (default 8).
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_YEARS=8

# Edge PWA and PowerSync: required for Story 1.8 offline shell and sync layer.
EDGE_SITE_NAME=Pilot Gate Site
POWERSYNC_URL=/powersync
POWERSYNC_TOKEN_ISSUER=inventory-edge
POWERSYNC_TOKEN_AUDIENCE=powersync
POWERSYNC_TOKEN_SECRET=replace-with-a-long-random-powersync-token-secret
POWERSYNC_TOKEN_TTL=15m
# Key id stamped on sync tokens and used by sync/powersync.yaml client_auth.jwks (optional).
POWERSYNC_TOKEN_KID=inventory-edge-hs256
POWERSYNC_SOURCE_PASSWORD=svc_powersync_password

# ERP inbound reference projections (Story 2.9, INT-ERP-01). A projection is stale when its
# last successful sync is older than this many milliseconds (default 900000 = 15 minutes).
ERP_SYNC_FRESHNESS_MS=900000

# Event envelope age floor (pilot triage 2026-09-12, ledger 11.5R-1). metadata.occurred_at older
# than this many days is refused INVALID_EVENT_ENVELOPE; offline edge uploads must sync within it.
# Default 30, maximum 3650. The test environment sets 3650 because its fixtures carry fixed dates.
EVENT_OCCURRED_AT_MAX_AGE_DAYS=30

# Job-work challan receipt against a service order with NO kit BOM (owner ruling 2026-09-22).
# Such an order names no expected customer material, so the expected-item check has nothing to
# hold the sku against. Default false: refused 409 JOBWORK_ORDER_KIT_BOM_REQUIRED (production).
# Staging sets true because the pilot's migrated job-work orders carry no kit BOM. Only "true" or
# "false"; leave UNSET to take the default, any other value refuses to start.
JOBWORK_RECEIPT_ALLOW_NO_KIT_BOM=false

# Maintenance closure coding (Story 7.8, FR-M-18). Three comma-separated, duplicate-free
# catalogues of at most 64 characters per code. Mandatory on breakdown work-order closure,
# optional all-or-none on preventive closure. Leave UNSET to take the defaults shown; a variable
# that is present but blank fails closed at startup (the warranty override reason-code rule).
MAINTENANCE_FAULT_CODES=MECHANICAL,ELECTRICAL,HYDRAULIC,PNEUMATIC,INSTRUMENTATION,STRUCTURAL,NO_FAULT_FOUND
MAINTENANCE_CAUSE_CODES=WEAR,OVERLOAD,CONTAMINATION,LUBRICATION,OPERATOR_ERROR,DESIGN,UNKNOWN
MAINTENANCE_REMEDY_CODES=REPLACED,REPAIRED,ADJUSTED,CLEANED,LUBRICATED,CALIBRATED,NO_ACTION

# Quality control (Story 8.1, FR-Q-01/FR-Q-02/FR-Q-05). QC_HEAD_APPROVAL_ROLES is the
# comma-separated, duplicate-free list of roles that represent QC Head-level authority; the DOA
# registry entry for qc.inspection_plan_approval must name one of them or plan approval fails
# closed. QC_INSPECTION_TASK_NOTIFICATION_ROLE is the role the inspection-task notification fans
# out to at the completion site. Leave UNSET to take the defaults shown; a present-but-blank
# QC_HEAD_APPROVAL_ROLES fails closed at startup (the closure-code catalogue rule).
QC_HEAD_APPROVAL_ROLES=qc_head
QC_INSPECTION_TASK_NOTIFICATION_ROLE=qc_inspector

# Story 11.5: TAXABLE-value threshold above which an inter-GSTIN branch transfer needs an e-way
# bill, in integer rupees. An e-way bill record is required at ship when the transfer's taxable
# value EXCEEDS this value (strictly greater).
#
# The statutory e-way-bill threshold is Rs 50,000 on the CONSIGNMENT value, which is the taxable
# value PLUS tax. This platform holds no tax rate and computes none, so the gate can only compare
# the taxable value. The default is therefore 50000 / 1.18 = 42373 (rounded down): the taxable
# value that already reaches a Rs 50,000 consignment value at the worst-case 18 percent IGST rate.
# Every consignment that could legally need an e-way bill trips the gate. Do NOT "fix" this back to
# 50000 - at 18 percent IGST a taxable value of 46000 is a consignment value of 54280, which needs
# an e-way bill that a 50000 taxable-value threshold would never ask for. Over-triggering at a lower
# tax rate costs one unnecessary e-way bill; under-triggering costs a penalty and a detained truck.
#
# Leave UNSET to take the default; a present-but-blank value fails closed at startup.
# GST_EWAY_BILL_TAXABLE_VALUE_THRESHOLD_INR=42373

# --- Staging stack on the VPS (deploy/compose, round table 2026-09-13) ---
# Public domain on Cloudflare DNS; nginx serves ims-staging.<domain> and auth.<domain> behind the
# Cloudflare proxy with an Origin CA certificate in deploy/compose/certs/ (git-ignored).
PUBLIC_DOMAIN=ancorlabs.org
# Loopback host ports the stack publishes (VPS survey 2026-09-13: 3000 is Gitea, 5432 is Gitea's
# Postgres on 10.0.0.1, so staging uses these; the defaults keep a clean host working unchanged).
APP_HOST_PORT=3100
EDGE_HOST_PORT=3101
POWERSYNC_HOST_PORT=3102
KEYCLOAK_HOST_PORT=3103
POSTGRES_HOST_PORT=5442
STANDBY_HOST_PORT=5443
# Standalone nginx profile on the staging VPS (Webuzo owns 80 and 443): publish on 8081 and 8443,
# Cloudflare Origin Rule sends 443 traffic to 8443; certificates from certbot standalone on port 80.
NGINX_HTTP_HOST_PORT=8081
NGINX_HTTPS_HOST_PORT=8443
TLS_CERT_PATH=/etc/letsencrypt/live/ims-staging.ancorlabs.org/fullchain.pem
TLS_KEY_PATH=/etc/letsencrypt/live/ims-staging.ancorlabs.org/privkey.pem
# Keycloak JVM heap (the box has 16 GB with Elasticsearch holding 8.5 GB).
KEYCLOAK_JAVA_HEAP=-Xms128m -Xmx512m
# Keycloak's own database role (created on first boot by init-keycloak-db.sh) and first-boot admin.
KEYCLOAK_DB_PASSWORD=replace-with-a-long-random-secret
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-secret
# Staging OIDC values for the app (realm "ims", client "ims-app"):
#   AUTH_JWKS_URI=https://auth.ancorlabs.org/realms/ims/protocol/openid-connect/certs
#   AUTH_ISSUER=https://auth.ancorlabs.org/realms/ims
#   AUTH_AUDIENCE=ims-app
#   AUTH_SUBJECT_CLAIM=email
# Story 1.12: browser sign-in config for the edge container, served at /auth/config and read per
# request (never NEXT_PUBLIC_*: the edge image is promoted between environments by digest).
# EDGE_AUTH_MODE=oidc (staging/production; compose sets it and defaults the authority to AUTH_ISSUER
# and the client id to ims-app, so the two lines below are only needed to override them) or
# local (next dev / Playwright default when unset: EDGE_DEV_SUBJECT names the dev-token subject,
# leave it empty to run with no bearer at all).
#   EDGE_AUTH_MODE=oidc
#   EDGE_OIDC_AUTHORITY=https://auth.ancorlabs.org/realms/ims
#   EDGE_OIDC_CLIENT_ID=ims-app
#   EDGE_DEV_SUBJECT=
# readonly_user password, set at first boot by init-role-passwords.sh alongside DB_PASSWORD,
# REPLICATION_PASSWORD and POWERSYNC_SOURCE_PASSWORD.
READONLY_PASSWORD=replace-with-a-long-random-secret
